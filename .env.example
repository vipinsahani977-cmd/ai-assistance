# ==============================================================================
# JARVIS AI VOICE ASSISTANT - ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to '.env' and add your actual API keys.
# NEVER commit your actual '.env' file to Git!

# Google Gemini API Key (Required for AI responses)
# Get a free API key at: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here

# Optional: Preferred model (Default: gemini-3.5-flash-lite)
AI_MODEL=gemini-3.5-flash-lite

# Optional: Assistant Persona Name (Default: Jarvis)
ASSISTANT_NAME=Jarvis
